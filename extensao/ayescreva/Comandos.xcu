<?xml version="1.0" encoding="UTF-8"?>
<!-- Rótulos dos comandos próprios do AY (a faixa de opções e os menus leem daqui). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="GenericCommands" oor:package="org.openoffice.Office.UI">
  <node oor:name="UserInterface">
    <node oor:name="Commands">
      <node oor:name="ayescreva:PaginaEmBranco" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Página em branco</value><value xml:lang="en-US">Blank Page</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Insere uma página vazia no ponto do cursor</value><value xml:lang="en-US">Insert a blank page at the cursor</value></prop>
      </node>
      <node oor:name="ayescreva:Recuperacao" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Recuperação de documentos</value><value xml:lang="en-US">Document Recovery</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Abre a pasta com cópias de segurança e de recuperação automática</value><value xml:lang="en-US">Open backup and autorecovery folder</value></prop>
      </node>
      <node oor:name="ayescreva:Guia" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Guia do AY ESCREVA</value><value xml:lang="en-US">AY ESCREVA Guide</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Abre o guia de utilização (funciona sem internet)</value><value xml:lang="en-US">Open the user guide (offline)</value></prop>
      </node>
      <node oor:name="ayescreva:Atalhos" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Atalhos de teclado</value><value xml:lang="en-US">Keyboard Shortcuts</value></prop>
      </node>
      <node oor:name="ayescreva:Limitacoes" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Limitações conhecidas</value><value xml:lang="en-US">Known Limitations</value></prop>
      </node>
      <node oor:name="ayescreva:Diagnostico" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Relatório de diagnóstico</value><value xml:lang="en-US">Diagnostic Report</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Gera um arquivo local com versão e configuração (sem conteúdo de documentos)</value><value xml:lang="en-US">Create a local file with version and settings</value></prop>
      </node>
      <node oor:name="ayescreva:DetalhesFontes" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Detalhes das fontes substituídas</value><value xml:lang="en-US">Substituted Fonts</value></prop>
      </node>
      <node oor:name="ayescreva:Assistente" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Assistente AY</value><value xml:lang="en-US">AY Assistant</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Abre o painel de revisão do texto (ortografia, gramática, estilo)</value><value xml:lang="en-US">Open the writing review panel</value></prop>
      </node>
      <node oor:name="ayescreva:VerificarDocumento" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Verificar documento</value><value xml:lang="en-US">Check Document</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Lista erros de ortografia, gramática e (se ligado) estilo no painel Assistente AY</value><value xml:lang="en-US">List spelling, grammar and style issues in the AY Assistant panel</value></prop>
      </node>
      <node oor:name="ayescreva:CorrecaoAutomatica" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Correção automática</value><value xml:lang="en-US">Automatic Correction</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Liga ou desliga a correção, ao digitar, de erros sem ambiguidade (Ctrl+Z desfaz cada correção)</value><value xml:lang="en-US">Toggle correction of unambiguous typos while typing</value></prop>
      </node>
      <node oor:name="ayescreva:NaoCorrigir" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Não corrigir novamente</value><value xml:lang="en-US">Do Not Correct Again</value></prop>
      </node>
      <node oor:name="ayescreva:FormatarTrabalho" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Formatar trabalho acadêmico</value><value xml:lang="en-US">Format Academic Work</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Aplica as regras da ABNT ou do modelo da instituição, com prévia, cópia opcional e uma ação de desfazer</value><value xml:lang="en-US">Apply ABNT or institution rules with preview, optional copy and single undo</value></prop>
      </node>
      <node oor:name="ayescreva:Conformidade" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Relatório de conformidade</value><value xml:lang="en-US">Conformity Report</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Confere o documento regra a regra, com norma, edição e origem de cada regra</value><value xml:lang="en-US">Check the document rule by rule</value></prop>
      </node>
      <node oor:name="ayescreva:VerificarAtualizacoes" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Verificar atualizações</value><value xml:lang="en-US">Check for Updates</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Consulta o site oficial só quando você pede; baixa e instala apenas com confirmação, se a versão estiver assinada pelo projeto</value><value xml:lang="en-US">Check the official site for a signed update</value></prop>
      </node>
      <node oor:name="ayescreva:ConferirReferencias" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Conferir referências</value><value xml:lang="en-US">Check References</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Confere citações do texto com a lista de referências e a apresentação de cada entrada; não cria nem completa referências</value><value xml:lang="en-US">Check citations against the reference list</value></prop>
      </node>
      <node oor:name="ayescreva:ConferirConsistencia" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Conferir consistência</value><value xml:lang="en-US">Check Consistency</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Aponta grafias diferentes do mesmo termo, siglas, numeração de figuras e tabelas e formatos misturados; não altera o texto</value><value xml:lang="en-US">Find inconsistent spellings, acronyms and numbering</value></prop>
      </node>
      <node oor:name="ayescreva:RevisaoIA" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Revisão com IA</value><value xml:lang="en-US">AI Review</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Abre o painel da IA local (opcional): revisar, deixar mais claro, formal ou simples, resumir o trecho selecionado</value><value xml:lang="en-US">Open the optional local AI panel</value></prop>
      </node>
      <node oor:name="ayescreva:GerenciarIA" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Gerenciar IA local</value><value xml:lang="en-US">Manage Local AI</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Baixar (opcional), escolher ou remover o modelo de IA local</value><value xml:lang="en-US">Download, choose or remove the local AI model</value></prop>
      </node>
      <node oor:name="ayescreva:Galeria" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Galeria de modelos</value><value xml:lang="en-US">Template Gallery</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Cria documento novo de um modelo: ofício, memorando, relatório, currículo, carta, ata, proposta ou modelo pessoal</value><value xml:lang="en-US">Create a new document from a template</value></prop>
      </node>
      <node oor:name="ayescreva:SalvarModelo" oor:op="replace">
        <prop oor:name="Label"><value xml:lang="pt-BR">Salvar como modelo</value><value xml:lang="en-US">Save as Template</value></prop>
        <prop oor:name="TooltipLabel"><value xml:lang="pt-BR">Grava o documento atual como modelo pessoal; o documento aberto não muda</value><value xml:lang="en-US">Save the current document as a personal template</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
