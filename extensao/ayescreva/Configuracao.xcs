<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuração do AY ESCREVA (perfil do usuário). SPDX-License-Identifier: MPL-2.0 -->
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Configuracao" oor:package="br.ayescreva" xml:lang="pt-BR">
  <component>
    <group oor:name="Revisao">
      <prop oor:name="CorrecaoAutomatica" oor:type="xs:boolean">
        <info><desc>Corrige ao digitar só casos inequívocos (tabela dados/correcoes_pt_BR.json), com proteções.</desc></info>
        <value>true</value>
      </prop>
      <prop oor:name="Gramatica" oor:type="xs:boolean">
        <info><desc>Categorias de gramática e pontuação do Lightproof pt-BR.</desc></info>
        <value>true</value>
      </prop>
      <prop oor:name="Estilo" oor:type="xs:boolean">
        <info><desc>Sugestões de estilo (Lightproof: pleonasmos, gerundismo, cacofonia; regras do AY). Opcional.</desc></info>
        <value>false</value>
      </prop>
      <prop oor:name="NaoCorrigir" oor:type="oor:string-list">
        <info><desc>Palavras que a correção automática não deve trocar ("Não corrigir novamente").</desc></info>
        <value/>
      </prop>
    </group>
    <group oor:name="Academico">
      <prop oor:name="Perfil" oor:type="xs:string">
        <info><desc>Último perfil escolhido em "Formatar trabalho acadêmico" (trabalho, projeto, artigo, relatorio, instituicao).</desc></info>
        <value>trabalho</value>
      </prop>
      <prop oor:name="Opcoes" oor:type="xs:string">
        <info><desc>Preferências escolhidas no assistente (JSON: fonte, recuo, alinhamento, frente e verso, contagem).</desc></info>
        <value>{}</value>
      </prop>
      <prop oor:name="Instituicao" oor:type="xs:string">
        <info><desc>Modelo da instituição (JSON: nome, manual e parâmetros que trocam os da norma ou as preferências).</desc></info>
        <value/>
      </prop>
    </group>
    <group oor:name="IA">
      <prop oor:name="Pasta" oor:type="xs:string">
        <info><desc>Pasta do motor e dos modelos da IA local (vazia: %LOCALAPPDATA%\AYEscreva\IA).</desc></info>
        <value/>
      </prop>
      <prop oor:name="Modelo" oor:type="xs:string">
        <info><desc>Modelo em uso (id de dados/ia.json); vazio: IA local não configurada.</desc></info>
        <value/>
      </prop>
      <prop oor:name="ComoAlteracaoControlada" oor:type="xs:boolean">
        <info><desc>Aplicar sugestões da IA como alterações controladas.</desc></info>
        <value>true</value>
      </prop>
    </group>
  </component>
</oor:component-schema>
